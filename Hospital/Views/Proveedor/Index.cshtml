@{
    ViewData["Title"] = "Proveedores";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="page-icon"><i class="fa-solid fa-truck-medical"></i></span>
        <div>
            <h1 class="h3 mb-1">Proveedores</h1>
            <p class="text-muted mb-0">Proveedores de medicamentos e insumos</p>
        </div>
    </div>
    @if (User.HasPermission("proveedor.crear"))
    {
        <button type="button" class="btn btn-hospital" id="btnNuevoProveedor">
            <i class="fa-solid fa-plus me-1"></i> Nuevo proveedor
        </button>
    }
</div>

<div class="card admin-card">
    <div class="card-body">
        <table id="proveedorTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Registro sanitario (Cofepris)</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="proveedorModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="proveedorModalTitle">Proveedor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="proveedorForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="proveedorId" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="proveedorNombre">Nombre</label>
                            <input type="text" id="proveedorNombre" name="proveedorNombre" class="form-control" maxlength="45" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="proveedorCorreo">Correo</label>
                            <input type="text" id="proveedorCorreo" name="proveedorCorreo" class="form-control" maxlength="100" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label" for="proveedorCofepris">Registro sanitario (Cofepris)</label>
                            <input type="text" id="proveedorCofepris" name="proveedorCofepris" class="form-control" maxlength="45" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-hospital" id="btnGuardarProveedor">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://unpkg.com/just-validate@4.3.0/dist/just-validate.production.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        window.proveedorConfig = {
            canUpdate: @User.HasPermission("proveedor.actualizar").ToString().ToLower(),
            canDelete: @User.HasPermission("proveedor.borrar").ToString().ToLower()
        };
    </script>
    <script src="~/js/proveedor.js" asp-append-version="true"></script>
}
