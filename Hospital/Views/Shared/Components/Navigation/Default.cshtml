@model IReadOnlyList<string>

@{
    bool Has(string p) => Model.Any(x => string.Equals(x, p, StringComparison.OrdinalIgnoreCase));
    bool HasAny(params string[] perms) => perms.Any(Has);
}

@if (HasAny("paciente.ver", "cita.ver", "receta.ver", "consulta.ver", "examen.ver"))
{
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-solid fa-heart-pulse me-1"></i> Atención
        </a>
        <ul class="dropdown-menu">
            @if (Has("paciente.ver"))
            {
                <li><a class="dropdown-item" asp-controller="Paciente" asp-action="Index"><i class="fa-solid fa-hospital-user me-2"></i>Pacientes</a></li>
            }
            @if (Has("cita.ver"))
            {
                <li><a class="dropdown-item" asp-controller="Cita" asp-action="Index"><i class="fa-solid fa-calendar-check me-2"></i>Citas</a></li>
            }
            @if (Has("receta.ver"))
            {
                <li><a class="dropdown-item" asp-controller="Receta" asp-action="Index"><i class="fa-solid fa-prescription me-2"></i>Recetas</a></li>
            }
            @if (Has("consulta.ver"))
            {
                <li><a class="dropdown-item" asp-controller="ConsultaMedica" asp-action="Index"><i class="fa-solid fa-notes-medical me-2"></i>Consultas médicas</a></li>
            }
            @if (Has("examen.ver"))
            {
                <li><a class="dropdown-item" asp-controller="ExamenMedico" asp-action="Index"><i class="fa-solid fa-microscope me-2"></i>Exámenes médicos</a></li>
            }
        </ul>
    </li>
}
