@{
    ViewData["Title"] = "Facturas";
    var pacientes = ViewBag.Pacientes as IReadOnlyList<Hospital.DTOS.PacienteTableDTO> ?? [];
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="page-icon"><i class="fa-solid fa-file-invoice-dollar"></i></span>
        <div>
            <h1 class="h3 mb-1">Facturas</h1>
            <p class="text-muted mb-0">Facturación a pacientes (el total se calcula con el detalle)</p>
        </div>
    </div>
    @if (User.HasPermission("factura.crear"))
    {
        <button type="button" class="btn btn-hospital" id="btnNuevoFactura">
            <i class="fa-solid fa-plus me-1"></i> Nueva factura
        </button>
    }
</div>

<div class="card admin-card">
    <div class="card-body">
        <table id="facturaTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Paciente</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="facturaModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="facturaModalTitle">Factura</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="facturaForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="facturaId" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="facturaFecha">Fecha</label>
                            <input type="date" id="facturaFecha" name="facturaFecha" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="facturaEstado">Estado</label>
                            <select id="facturaEstado" name="facturaEstado" class="form-select">
                            <option value="">Seleccione</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Pagada">Pagada</option>
                            <option value="Anulada">Anulada</option>
                        </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="facturaPacienteId">Paciente</label>
                            <select id="facturaPacienteId" name="facturaPacienteId" class="form-select">
                                <option value="">Seleccione una opcion</option>
                                @foreach (var item in pacientes)
                                {
                                    <option value="@item.id">@item.display</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-hospital" id="btnGuardarFactura">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://unpkg.com/just-validate@4.3.0/dist/just-validate.production.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        window.facturaConfig = {
            canUpdate: @User.HasPermission("factura.actualizar").ToString().ToLower(),
            canDelete: @User.HasPermission("factura.borrar").ToString().ToLower()
        };
    </script>
    <script src="~/js/factura.js" asp-append-version="true"></script>
}
