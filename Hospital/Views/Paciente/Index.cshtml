@{
    ViewData["Title"] = "Pacientes";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="page-icon"><i class="fa-solid fa-hospital-user"></i></span>
        <div>
            <h1 class="h3 mb-1">Pacientes</h1>
            <p class="text-muted mb-0">Solo tú registras pacientes. La cédula es lo que usan para entrar a su portal (pedir citas y recetas).</p>
        </div>
    </div>
    @if (User.HasPermission("paciente.crear"))
    {
        <button type="button" class="btn btn-hospital" id="btnNuevoPaciente">
            <i class="fa-solid fa-plus me-1"></i> Nuevo paciente
        </button>
    }
</div>

<div class="card admin-card">
    <div class="card-body">
        <table id="pacienteTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Cédula</th>
                    <th>Fecha de nacimiento</th>
                    <th>Sexo</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="pacienteModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="pacienteModalTitle">Paciente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="pacienteForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="pacienteId" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="pacienteNombre">Nombre</label>
                            <input type="text" id="pacienteNombre" name="pacienteNombre" class="form-control" maxlength="45" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="pacienteApellido">Apellido</label>
                            <input type="text" id="pacienteApellido" name="pacienteApellido" class="form-control" maxlength="45" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="pacienteCedula">Cédula</label>
                            <input type="text" id="pacienteCedula" name="pacienteCedula" class="form-control" maxlength="14" placeholder="14 caracteres, sin guiones" autocomplete="off" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="pacienteFechaNacimiento">Fecha de nacimiento</label>
                            <input type="date" id="pacienteFechaNacimiento" name="pacienteFechaNacimiento" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="pacienteSexo">Sexo</label>
                            <select id="pacienteSexo" name="pacienteSexo" class="form-select">
                            <option value="">Seleccione</option>
                            <option value="Masculino">Masculino</option>
                            <option value="Femenino">Femenino</option>
                        </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="pacienteTelefono">Teléfono</label>
                            <input type="text" id="pacienteTelefono" name="pacienteTelefono" class="form-control" maxlength="8" inputmode="numeric" placeholder="8 dígitos" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label" for="pacienteDireccion">Dirección</label>
                            <input type="text" id="pacienteDireccion" name="pacienteDireccion" class="form-control" maxlength="150" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-hospital" id="btnGuardarPaciente">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://unpkg.com/just-validate@4.3.0/dist/just-validate.production.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        window.pacienteConfig = {
            canUpdate: @User.HasPermission("paciente.actualizar").ToString().ToLower(),
            canDelete: @User.HasPermission("paciente.borrar").ToString().ToLower()
        };
    </script>
    <script src="~/js/paciente.js" asp-append-version="true"></script>
}
