@{
    ViewData["Title"] = "Habitaciones";
    var pacientes = ViewBag.Pacientes as IReadOnlyList<Hospital.DTOS.PacienteTableDTO> ?? [];
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="page-icon"><i class="fa-solid fa-bed-pulse"></i></span>
        <div>
            <h1 class="h3 mb-1">Habitaciones</h1>
            <p class="text-muted mb-0">Control de habitaciones y su disponibilidad</p>
        </div>
    </div>
    @if (User.HasPermission("habitacion.crear"))
    {
        <button type="button" class="btn btn-hospital" id="btnNuevoHabitacion">
            <i class="fa-solid fa-plus me-1"></i> Nueva habitación
        </button>
    }
</div>

<div class="card admin-card">
    <div class="card-body">
        <table id="habitacionTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Número</th>
                    <th>Estado</th>
                    <th>Paciente</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="habitacionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="habitacionModalTitle">Habitación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="habitacionForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="habitacionId" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="habitacionNumero">Número</label>
                            <input type="text" id="habitacionNumero" name="habitacionNumero" class="form-control" maxlength="45" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="habitacionEstado">Estado</label>
                            <select id="habitacionEstado" name="habitacionEstado" class="form-select">
                            <option value="">Seleccione</option>
                            <option value="Disponible">Disponible</option>
                            <option value="Ocupada">Ocupada</option>
                            <option value="Mantenimiento">Mantenimiento</option>
                        </select>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label" for="habitacionPacienteId">Paciente (al asignarlo la habitación queda Ocupada)</label>
                            <select id="habitacionPacienteId" name="habitacionPacienteId" class="form-select">
                                <option value="">Sin paciente</option>
                                @foreach (var item in pacientes)
                                {
                                    <option value="@item.id">@item.display (@item.cedula)</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-hospital" id="btnGuardarHabitacion">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://unpkg.com/just-validate@4.3.0/dist/just-validate.production.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        window.habitacionConfig = {
            canUpdate: @User.HasPermission("habitacion.actualizar").ToString().ToLower(),
            canDelete: @User.HasPermission("habitacion.borrar").ToString().ToLower()
        };
    </script>
    <script src="~/js/habitacion.js" asp-append-version="true"></script>
}
