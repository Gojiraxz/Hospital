@{
    ViewData["Title"] = "Consultas médicas";
    var doctores = ViewBag.Doctores as IReadOnlyList<Hospital.DTOS.DoctorTableDTO> ?? [];
    var citas = ViewBag.Citas as IReadOnlyList<Hospital.DTOS.CitaTableDTO> ?? [];
    var pacientes = ViewBag.Pacientes as IReadOnlyList<Hospital.DTOS.PacienteTableDTO> ?? [];
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="page-icon"><i class="fa-solid fa-notes-medical"></i></span>
        <div>
            <h1 class="h3 mb-1">Consultas médicas</h1>
            <p class="text-muted mb-0">Diagnósticos y tratamientos</p>
        </div>
    </div>
    @if (User.HasPermission("consulta.crear"))
    {
        <button type="button" class="btn btn-hospital" id="btnNuevoConsultaMedica">
            <i class="fa-solid fa-plus me-1"></i> Nueva consulta médica
        </button>
    }
</div>

<div class="card admin-card">
    <div class="card-body">
        <table id="consultaMedicaTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha y hora</th>
                    <th>Diagnóstico</th>
                    <th>Tratamiento</th>
                    <th>Doctor</th>
                    <th>Cita</th>
                    <th>Paciente</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="consultaMedicaModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="consultaMedicaModalTitle">Consulta médica</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="consultaMedicaForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="consultaMedicaId" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="consultaMedicaFecha">Fecha y hora</label>
                            <input type="datetime-local" id="consultaMedicaFecha" name="consultaMedicaFecha" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="consultaMedicaDiagnostico">Diagnóstico</label>
                            <input type="text" id="consultaMedicaDiagnostico" name="consultaMedicaDiagnostico" class="form-control" maxlength="250" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="consultaMedicaTratamiento">Tratamiento</label>
                            <input type="text" id="consultaMedicaTratamiento" name="consultaMedicaTratamiento" class="form-control" maxlength="250" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="consultaMedicaDoctorId">Doctor</label>
                            <select id="consultaMedicaDoctorId" name="consultaMedicaDoctorId" class="form-select">
                                <option value="">Seleccione una opcion</option>
                                @foreach (var item in doctores)
                                {
                                    <option value="@item.id">@item.display</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="consultaMedicaCitaId">Cita</label>
                            <select id="consultaMedicaCitaId" name="consultaMedicaCitaId" class="form-select">
                                <option value="">Seleccione una opcion</option>
                                @foreach (var item in citas)
                                {
                                    <option value="@item.id">@item.display</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="consultaMedicaPacienteId">Paciente</label>
                            <select id="consultaMedicaPacienteId" name="consultaMedicaPacienteId" class="form-select">
                                <option value="">Seleccione una opcion</option>
                                @foreach (var item in pacientes)
                                {
                                    <option value="@item.id">@item.display</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-hospital" id="btnGuardarConsultaMedica">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://unpkg.com/just-validate@4.3.0/dist/just-validate.production.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        window.consultaMedicaConfig = {
            canUpdate: @User.HasPermission("consulta.actualizar").ToString().ToLower(),
            canDelete: @User.HasPermission("consulta.borrar").ToString().ToLower()
        };
    </script>
    <script src="~/js/consultaMedica.js" asp-append-version="true"></script>
}
