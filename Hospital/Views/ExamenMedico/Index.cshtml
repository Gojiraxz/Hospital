@{
    ViewData["Title"] = "Exámenes médicos";
    var consultasMedicas = ViewBag.ConsultasMedicas as IReadOnlyList<Hospital.DTOS.ConsultaMedicaTableDTO> ?? [];
    var laboratorios = ViewBag.Laboratorios as IReadOnlyList<Hospital.DTOS.LaboratorioTableDTO> ?? [];
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="page-icon"><i class="fa-solid fa-microscope"></i></span>
        <div>
            <h1 class="h3 mb-1">Exámenes médicos</h1>
            <p class="text-muted mb-0">Exámenes solicitados y sus resultados</p>
        </div>
    </div>
    @if (User.HasPermission("examen.crear"))
    {
        <button type="button" class="btn btn-hospital" id="btnNuevoExamenMedico">
            <i class="fa-solid fa-plus me-1"></i> Nuevo examen médico
        </button>
    }
</div>

<div class="card admin-card">
    <div class="card-body">
        <table id="examenMedicoTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tipo de examen</th>
                    <th>Resultado</th>
                    <th>Estado</th>
                    <th>Consulta médica</th>
                    <th>Laboratorio</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="examenMedicoModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="examenMedicoModalTitle">Examen médico</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="examenMedicoForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="examenMedicoId" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="examenMedicoTipoExamen">Tipo de examen</label>
                            <input type="text" id="examenMedicoTipoExamen" name="examenMedicoTipoExamen" class="form-control" maxlength="45" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="examenMedicoResultado">Resultado</label>
                            <input type="text" id="examenMedicoResultado" name="examenMedicoResultado" class="form-control" maxlength="250" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="examenMedicoEstado">Estado</label>
                            <select id="examenMedicoEstado" name="examenMedicoEstado" class="form-select">
                            <option value="">Seleccione</option>
                            <option value="Solicitado">Solicitado</option>
                            <option value="En proceso">En proceso</option>
                            <option value="Entregado">Entregado</option>
                        </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="examenMedicoConsultaMedicaId">Consulta médica</label>
                            <select id="examenMedicoConsultaMedicaId" name="examenMedicoConsultaMedicaId" class="form-select">
                                <option value="">Seleccione una opcion</option>
                                @foreach (var item in consultasMedicas)
                                {
                                    <option value="@item.id">@item.display</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="examenMedicoLaboratorioId">Laboratorio</label>
                            <select id="examenMedicoLaboratorioId" name="examenMedicoLaboratorioId" class="form-select">
                                <option value="">Seleccione una opcion</option>
                                @foreach (var item in laboratorios)
                                {
                                    <option value="@item.id">@item.display</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-hospital" id="btnGuardarExamenMedico">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://unpkg.com/just-validate@4.3.0/dist/just-validate.production.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        window.examenMedicoConfig = {
            canUpdate: @User.HasPermission("examen.actualizar").ToString().ToLower(),
            canDelete: @User.HasPermission("examen.borrar").ToString().ToLower()
        };
    </script>
    <script src="~/js/examenMedico.js" asp-append-version="true"></script>
}
