@{
    ViewData["Title"] = "Medicamentos";
    var proveedores = ViewBag.Proveedores as IReadOnlyList<Hospital.DTOS.ProveedorTableDTO> ?? [];
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="page-icon"><i class="fa-solid fa-pills"></i></span>
        <div>
            <h1 class="h3 mb-1">Medicamentos</h1>
            <p class="text-muted mb-0">Inventario de farmacia</p>
        </div>
    </div>
    @if (User.HasPermission("medicamento.crear"))
    {
        <button type="button" class="btn btn-hospital" id="btnNuevoMedicamento">
            <i class="fa-solid fa-plus me-1"></i> Nuevo medicamento
        </button>
    }
</div>

<div class="card admin-card">
    <div class="card-body">
        <table id="medicamentoTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Stock</th>
                    <th>Precio</th>
                    <th>Proveedor</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="medicamentoModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="medicamentoModalTitle">Medicamento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="medicamentoForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="medicamentoId" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="medicamentoNombre">Nombre</label>
                            <input type="text" id="medicamentoNombre" name="medicamentoNombre" class="form-control" maxlength="45" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="medicamentoDescripcion">Descripción</label>
                            <input type="text" id="medicamentoDescripcion" name="medicamentoDescripcion" class="form-control" maxlength="250" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="medicamentoStock">Stock</label>
                            <input type="number" id="medicamentoStock" name="medicamentoStock" class="form-control" min="0" max="100000" step="1" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="medicamentoPrecio">Precio</label>
                            <input type="number" id="medicamentoPrecio" name="medicamentoPrecio" class="form-control" min="0.01" step="0.01" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="medicamentoProveedorId">Proveedor</label>
                            <select id="medicamentoProveedorId" name="medicamentoProveedorId" class="form-select">
                                <option value="">Seleccione una opcion</option>
                                @foreach (var item in proveedores)
                                {
                                    <option value="@item.id">@item.display</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-hospital" id="btnGuardarMedicamento">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://unpkg.com/just-validate@4.3.0/dist/just-validate.production.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        window.medicamentoConfig = {
            canUpdate: @User.HasPermission("medicamento.actualizar").ToString().ToLower(),
            canDelete: @User.HasPermission("medicamento.borrar").ToString().ToLower()
        };
    </script>
    <script src="~/js/medicamento.js" asp-append-version="true"></script>
}
