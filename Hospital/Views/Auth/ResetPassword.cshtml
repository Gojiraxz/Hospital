@model Hospital.DTOS.ResetPasswordRequestDTO
@{
    Layout = null; // Eliminamos el layout para esta vista específica
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hospital Digital - Restablecer contraseña</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link href="~/css/login.css" rel="stylesheet" />
</head>
<body>
    <div class="overlay">
        <div class="popup-container">
            <div class="brand">
                <img src="~/img/logo-icon.svg" alt="Logo Hospital Digital" />
                <div><strong>Hospital Digital</strong><span>CUIDAMOS TU SALUD</span></div>
            </div>
            <main>
                <div class="form-container">

                    <div id="resetPassForm" class="form active">
                        <h1>Resetear contraseña</h1>
                        <p class="subtitle">Porfavor ingresa tu nueva password</p>

                        <form id="newPasswordForm">
                            <input type="hidden" id="email" value="@Model.email" />
                            <input type="hidden" id="token" value="@Model.token" />
                            <div class="input-group">
                                <i class="fa-solid fa-lock input-icon" aria-hidden="true"></i>
                                <input type="password" id="newPassword" placeholder="Nueva contraseña" required>
                            </div>

                            <div class="input-group">
                                <i class="fa-solid fa-lock input-icon" aria-hidden="true"></i>
                                <input type="password" id="confirmPassword" placeholder="Confirmar contraseña" required>
                            </div>

                            <button type="submit" class="signup-btn">Confirmar Cambio</button>
                        </form>

                    </div>
                </div>
            </main>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/just-validate@4.2.0/dist/just-validate.production.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/ResetPassword.js"></script>
</body>
</html>