@{
    ViewData["Title"] = "Citas";
    var doctores = ViewBag.Doctores as IReadOnlyList<Hospital.DTOS.DoctorTableDTO> ?? [];
    var pacientes = ViewBag.Pacientes as IReadOnlyList<Hospital.DTOS.PacienteTableDTO> ?? [];
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="page-icon"><i class="fa-solid fa-calendar-check"></i></span>
        <div>
            <h1 class="h3 mb-1">Citas</h1>
            <p class="text-muted mb-0">Agenda de citas médicas</p>
        </div>
    </div>
    @if (User.HasPermission("cita.crear"))
    {
        <button type="button" class="btn btn-hospital" id="btnNuevoCita">
            <i class="fa-solid fa-plus me-1"></i> Nueva cita
        </button>
    }
</div>

<div class="card admin-card">
    <div class="card-body">
        <table id="citaTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha y hora</th>
                    <th>Estado</th>
                    <th>Motivo</th>
                    <th>Doctor</th>
                    <th>Paciente</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="citaModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="citaModalTitle">Cita</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="citaForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="citaId" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="citaFecha">Fecha y hora</label>
                            <input type="datetime-local" id="citaFecha" name="citaFecha" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="citaEstado">Estado</label>
                            <select id="citaEstado" name="citaEstado" class="form-select">
                            <option value="">Seleccione</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Confirmada">Confirmada</option>
                            <option value="Atendida">Atendida</option>
                            <option value="Cancelada">Cancelada</option>
                        </select>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label" for="citaMotivo">Motivo</label>
                            <input type="text" id="citaMotivo" name="citaMotivo" class="form-control" maxlength="250" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="citaDoctorId">Doctor</label>
                            <select id="citaDoctorId" name="citaDoctorId" class="form-select">
                                <option value="">Seleccione una opcion</option>
                                @foreach (var item in doctores)
                                {
                                    <option value="@item.id">@item.display</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="citaPacienteId">Paciente</label>
                            <select id="citaPacienteId" name="citaPacienteId" class="form-select">
                                <option value="">Seleccione una opcion</option>
                                @foreach (var item in pacientes)
                                {
                                    <option value="@item.id">@item.display</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-hospital" id="btnGuardarCita">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://unpkg.com/just-validate@4.3.0/dist/just-validate.production.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script>
        window.citaConfig = {
            canUpdate: @User.HasPermission("cita.actualizar").ToString().ToLower(),
            canDelete: @User.HasPermission("cita.borrar").ToString().ToLower()
        };
    </script>
    <script src="~/js/cita.js" asp-append-version="true"></script>
}
